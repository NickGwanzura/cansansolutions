    "dotenv": "^17.3.1",
    "framer-motion": "^12.37.0",
    "groq-sdk": "^1.1.2",
    "html-to-image": "^1.11.13",
    "html2pdf.js": "^0.14.0",
    "next": "16.1.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "resend": "^6.16.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "uploadthing": "^7.7.4",
    "zustand": "^5.0.12"
