# Database connection (PostgreSQL)
DATABASE_URL="postgresql://username:password@host:port/database"

# Data directory for products.json
# For Docker/Railway production with a mounted volume: DATA_DIR=/app/data
# For local development: leave blank (defaults to ./data)
DATA_DIR=

# Maintenance Mode - set to 'true' to enable coming soon page
MAINTENANCE_MODE=false
MAINTENANCE_PASSWORD=your_password_here

# Optional: Redis URL for caching
# REDIS_URL=redis://localhost:6379

# Optional: Admin password for /admin panel
ADMIN_PASSWORD=your_admin_password

# Optional: UploadThing token for admin image uploads
UPLOADTHING_TOKEN=your_uploadthing_token

# Optional: Site URL used for CSRF origin validation
SITE_URL=https://cansansolutions.shop

# Company registration numbers (can also be set via /admin/settings)
COMPANY_TIN=2001360981
COMPANY_VAT=220445061
